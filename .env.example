# Server Configuration
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=local
# Set CORS_ORIGINS=* to allow any browser origin, or use a comma-separated allowlist.

# Authentication (optional - disabled by default)
# AUTH_ENABLED=1
# AUTH_API_KEY=your_secret_api_key_here
# DANGEROUSLY_ALLOW_IMPORTS=1
# DANGEROUSLY_ALLOW_VOICE_CLONING=1

# Kokoro TTS Configuration
# TTS_ENABLED=1
TTS_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
TTS_DTYPE=fp32
TTS_DEVICE=cpu
TTS_DEFAULT_VOICE=af_heart
TTS_DEFAULT_SPEED=1.0

# Transcription Configuration
TRANSCRIPTION_ENABLED=1
TRANSCRIBE_TIMEOUT=300000

# Qwen3-ASR + ForcedAligner (Optional; installed in isolated .venv-qwen-asr)
# QWEN_ASR_ENABLED=0
# QWEN_ASR_MODEL_ID=mlx-community/Qwen3-ASR-0.6B-8bit
# QWEN_ASR_ALIGNER_MODEL_ID=mlx-community/Qwen3-ForcedAligner-0.6B-8bit
# QWEN_ASR_PYTHON_PATH=./.venv-qwen-asr/bin/python3
# QWEN_ASR_DEFAULT_LANGUAGE=auto
# QWEN_ASR_TIMEOUT=300000
# QWEN_ASR_DAEMON_STARTUP_TIMEOUT=300000
# PREWARM_QWEN_ASR=0

# MOSS Transcribe-Diarize (Experimental; isolated .venv-moss-transcribe)
# One-pass English/Chinese transcription, speaker labels, and segment timestamps.
# Source and model revisions are pinned because this integration is intentionally experimental.
# MOSS_TD_ENABLED=0
# MOSS_TD_MODEL_ID=OpenMOSS-Team/MOSS-Transcribe-Diarize
# MOSS_TD_MODEL_REVISION=d7231bbae2587a4af278735eb765b318c4f64edd
# MOSS_TD_PACKAGE_REVISION=b5ad0f8386b155ddb89f9332ba3ca71891900357
# MOSS_TD_PYTHON_PATH=./.venv-moss-transcribe/bin/python3
# MOSS_TD_DEVICE=mps
# MOSS_TD_DTYPE=fp16
# MOSS_TD_MAX_NEW_TOKENS=5120
# MOSS_TD_MAX_AUDIO_SECONDS=5400
# MOSS_TD_TIMEOUT=3600000
# MOSS_TD_DAEMON_STARTUP_TIMEOUT=300000
# PREWARM_MOSS_TD=0

# Speaker Diarization (Optional; gated model access required)
# Accept https://huggingface.co/pyannote/speaker-diarization-community-1
# and run `uvx hf auth login`, or set HF_TOKEN for a headless server.
# DIARIZATION_ENABLED=0
# DIARIZATION_MODEL_ID=pyannote/speaker-diarization-community-1
# HF_TOKEN=your_huggingface_token_here
# DIARIZATION_TIMEOUT=600000
# DIARIZATION_DAEMON_STARTUP_TIMEOUT=180000
# PREWARM_DIARIZATION=0

# File Upload Configuration
MAX_FILE_SIZE_MB=100

# Pocket TTS Configuration (Optional)
# POCKET_TTS_ENABLED=0
# POCKET_TTS_DEFAULT_VOICE=alba
# POCKET_TTS_TIMEOUT=60000
# POCKET_TTS_DAEMON_STARTUP_TIMEOUT=60000
# PREWARM_POCKET_TTS=0
# POCKET_TTS_VOICE_CLONES_DIR=./pocket_voice_clones

# MOSS-TTS-Nano (Optional; installed in isolated .venv-moss-tts)
# Multilingual reference-voice synthesis; current MLX backend is non-streaming.
# MOSS_TTS_ENABLED=0
# MOSS_TTS_MODEL_ID=mlx-community/MOSS-TTS-Nano-100M
# MOSS_TTS_PYTHON_PATH=./.venv-moss-tts/bin/python3
# MOSS_TTS_DEFAULT_VOICE=
# MOSS_TTS_TIMEOUT=300000
# MOSS_TTS_TIMEOUT_PER_CHAR_MS=120
# MOSS_TTS_TIMEOUT_MAX=1800000
# MOSS_TTS_DAEMON_STARTUP_TIMEOUT=300000
# PREWARM_MOSS_TTS=0
# MOSS_TTS_VOICES_DIR=./moss_voice_clones
