# Server Configuration
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=local
# Set CORS_ORIGINS=* to allow any browser origin, or use a comma-separated allowlist.

# Authentication (optional - disabled by default)
# AUTH_ENABLED=1
# AUTH_API_KEY=your_secret_api_key_here
# DANGEROUSLY_ALLOW_IMPORTS=1

# Kokoro TTS Configuration
# TTS_ENABLED=1
TTS_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
TTS_DTYPE=fp32
TTS_DEVICE=cpu
TTS_DEFAULT_VOICE=af_heart
TTS_DEFAULT_SPEED=1.0

# Transcription Configuration
TRANSCRIPTION_ENABLED=1
TRANSCRIBE_TIMEOUT=300000

# File Upload Configuration
MAX_FILE_SIZE_MB=100

# Pocket TTS Configuration (Optional)
# POCKET_TTS_ENABLED=0
# POCKET_TTS_DEFAULT_VOICE=alba
# POCKET_TTS_TIMEOUT=60000
# POCKET_TTS_DAEMON_STARTUP_TIMEOUT=60000
# PREWARM_POCKET_TTS=0
# POCKET_TTS_VOICE_CLONES_DIR=./pocket_voice_clones
