# Server Configuration
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=local
# Set CORS_ORIGINS=* to allow any browser origin, or use a comma-separated allowlist.

# Authentication (optional - disabled by default)
# AUTH_ENABLED=1
# AUTH_API_KEY=your_secret_api_key_here
# DANGEROUSLY_ALLOW_IMPORTS=1

# Kokoro TTS Configuration
# TTS_ENABLED=1
TTS_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
TTS_DTYPE=fp32
TTS_DEVICE=cpu
TTS_DEFAULT_VOICE=af_heart
TTS_DEFAULT_SPEED=1.0

# Transcription Configuration
TRANSCRIPTION_ENABLED=1
TRANSCRIBE_TIMEOUT=300000

# Qwen3-ASR + ForcedAligner (Optional; installed in isolated .venv-qwen-asr)
# QWEN_ASR_ENABLED=0
# QWEN_ASR_MODEL_ID=mlx-community/Qwen3-ASR-0.6B-8bit
# QWEN_ASR_ALIGNER_MODEL_ID=mlx-community/Qwen3-ForcedAligner-0.6B-8bit
# QWEN_ASR_PYTHON_PATH=./.venv-qwen-asr/bin/python3
# QWEN_ASR_DEFAULT_LANGUAGE=auto
# QWEN_ASR_TIMEOUT=300000
# QWEN_ASR_DAEMON_STARTUP_TIMEOUT=300000
# PREWARM_QWEN_ASR=0

# Speaker Diarization (Optional; gated model access required)
# Accept https://huggingface.co/pyannote/speaker-diarization-community-1
# and run `uvx hf auth login`, or set HF_TOKEN for a headless server.
# DIARIZATION_ENABLED=0
# DIARIZATION_MODEL_ID=pyannote/speaker-diarization-community-1
# HF_TOKEN=your_huggingface_token_here
# DIARIZATION_TIMEOUT=600000
# DIARIZATION_DAEMON_STARTUP_TIMEOUT=180000
# PREWARM_DIARIZATION=0

# File Upload Configuration
MAX_FILE_SIZE_MB=100

# Pocket TTS Configuration (Optional)
# POCKET_TTS_ENABLED=0
# POCKET_TTS_DEFAULT_VOICE=alba
# POCKET_TTS_TIMEOUT=60000
# POCKET_TTS_DAEMON_STARTUP_TIMEOUT=60000
# PREWARM_POCKET_TTS=0
# POCKET_TTS_VOICE_CLONES_DIR=./pocket_voice_clones
