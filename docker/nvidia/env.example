# sogni-voice on Linux + NVIDIA: copy to .env at the repo root and set the key.
# The engines pick their Linux backends automatically (vLLM-Omni for Fish,
# transformers for Parakeet); see docs/linux-nvidia.md.
PORT=3000
# Bind to the address clients reach (0.0.0.0 for all interfaces).
HOST=0.0.0.0
AUTH_ENABLED=1
AUTH_API_KEY=change-me
CORS_ORIGINS=local

# Speech-to-text: NVIDIA's Parakeet TDT 0.6B v3 from ./checkpoints (batch only;
# realtime streaming needs the MLX backend).
TRANSCRIPTION_ENABLED=1
PARAKEET_MODEL_ID=./checkpoints/parakeet-tdt-0.6b-v3
PREWARM_TRANSCRIPTION=1

# Fish S2 Pro and Fish Drama 3, rendered by the vLLM-Omni compose services.
FISH_TTS_ENABLED=1
FISH_TTS_PYTHON_PATH=./.venv/bin/python3
PREWARM_FISH_TTS=1
DRAMA3_TTS_ENABLED=1
DRAMA3_TTS_PYTHON_PATH=./.venv/bin/python3
PREWARM_DRAMA3_TTS=1

# Pocket TTS runs on the CPU.
POCKET_TTS_ENABLED=1
PREWARM_POCKET_TTS=1

# Kokoro, Qwen3-TTS/ASR and MOSS are MLX-only.
TTS_ENABLED=0
QWEN_TTS_ENABLED=0
QWEN_ASR_ENABLED=0
MOSS_TTS_ENABLED=0
